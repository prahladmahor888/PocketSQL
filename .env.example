# PocketSQL Environment Configuration (.env)
# Copy this file to .env or edit PocketSQL/.env

# ==========================================
# 1. Android App Release Signing (.jks / .keystore)
# ==========================================
# Path to your release keystore file (absolute path or relative to project root)
KEYSTORE_FILE=my-release-key.jks
# Keystore password
KEYSTORE_PASSWORD=your_keystore_password
# Key Alias
KEY_ALIAS=your_key_alias
# Key Password
KEY_PASSWORD=your_key_password

# ==========================================
# 2. Database Engine & Seeding Configuration
# ==========================================
DEFAULT_DATABASES=banking,ecommerce,school,social
DEFAULT_ACTIVE_DB=ecommerce
ASYNC_DB_INIT=true
DB_SEED_BATCH_YIELD=20
AUTO_LOGIN=true

# ==========================================
# 3. Thread Scheduler CPU Priorities
# ==========================================
QUERY_THREAD_PRIORITY=-8
INIT_THREAD_PRIORITY=10

# ==========================================
# 4. REST API Server Configuration
# ==========================================
API_SERVER_ENABLED=true
API_SERVER_PORT=8080
API_SSL_PORT=8443

# ==========================================
# 5. Internal Android Keystore & Cryptography
# ==========================================
KEYSTORE_PROVIDER=AndroidKeyStore
KEYSTORE_KEY_ALIAS=PocketSQLAESKeyAlias
KEYSTORE_TLS_CERT_ALIAS=psql_entry
KEYSTORE_AES_KEY_SIZE=256
KEYSTORE_RSA_KEY_SIZE=2048
KEYSTORE_CERT_SUBJECT=CN=localhost, O=PocketSQL, C=US
KEYSTORE_CERT_VALIDITY_YEARS=1
KEYSTORE_ENCRYPTION_CIPHER=AES/GCM/NoPadding
